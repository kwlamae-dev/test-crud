# Supabase PostgreSQL connection string. Copy it from Supabase > Project Settings > Database.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres

# Optional: path to the CA certificate downloaded from your Supabase project.
# When set, the backend validates the database server's TLS certificate.
# DATABASE_SSL_CA=certs/prod-ca-2021.crt

# Port used by the Express API (default: 5000)
PORT=5000

# Optional: comma-separated list of allowed browser origins ("*" allows all).
# Localhost origins on any port are allowed automatically during development.
# CORS_ORIGIN=http://localhost:5173

# Set to false to start with empty tables instead of demo data.
# On startup, the backend creates the required tables in Supabase automatically.
SEED=true
